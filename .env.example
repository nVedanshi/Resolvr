# PostgreSQL connection string used by Prisma CLI and the API.
# Replace the credentials with your own local PostgreSQL setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"

# Port the Express API listens on.
PORT=4000

# Comma-separated list of allowed browser origins (development only).
# The Vite dev server proxies /api, so this rarely needs changing.
CLIENT_ORIGIN="http://localhost:5173"